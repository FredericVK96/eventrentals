{
  "version": 2,
  "cleanUrls": true,
  "alias": ["eventrentals.be", "www.eventrentals.be"],
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "*.jpg", "use": "@vercel/static" },
    { "src": "*.jpeg", "use": "@vercel/static" },
    { "src": "*.webp", "use": "@vercel/static" },
    { "src": "*.jfif", "use": "@vercel/static" },
    { "src": "*.avif", "use": "@vercel/static" },
    { "src": "*.xml", "use": "@vercel/static" },
    { "src": "*.txt", "use": "@vercel/static" },
    { "src": "search-data.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(.*)", "has": [{ "type": "host", "value": "eventrentals.be" }], "status": 301, "headers": { "Location": "https://www.eventrentals.be/$1" } },
    { "src": "/springkasteel-huren-gent", "status": 301, "headers": { "Location": "/feestmateriaal-huren-gent" } },
    { "src": "/springkasteel-huren-de-pinte", "status": 301, "headers": { "Location": "/feestmateriaal-huren-de-pinte" } },
    { "src": "/springkasteel-huren-nazareth", "status": 301, "headers": { "Location": "/feestmateriaal-huren-nazareth" } },
    { "src": "/springkasteel-huren-merelbeke", "status": 301, "headers": { "Location": "/feestmateriaal-huren-merelbeke" } },
    { "src": "/springkasteel-huren-sint-martens-latem", "status": 301, "headers": { "Location": "/feestmateriaal-huren-sint-martens-latem" } },
    { "src": "/springkasteel-huren-gavere", "status": 301, "headers": { "Location": "/feestmateriaal-huren-gavere" } },
    { "src": "/springkasteel-huren-deinze", "status": 301, "headers": { "Location": "/feestmateriaal-huren-deinze" } },
    { "src": "/springkasteel-huren-oudenaarde", "status": 301, "headers": { "Location": "/feestmateriaal-huren-oudenaarde" } },
    { "src": "/springkasteel-huren-zulte", "status": 301, "headers": { "Location": "/feestmateriaal-huren-zulte" } },
    { "src": "/partytent-3x6m", "status": 301, "headers": { "Location": "/partytent" } },
    { "src": "/partytent-4x8m", "status": 301, "headers": { "Location": "/partytent" } },
    { "src": "/easy-up-vouwtent", "status": 301, "headers": { "Location": "/partytent" } },
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/sitemap.xml", "dest": "/server.js" },
    { "src": "/robots.txt", "dest": "/server.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
