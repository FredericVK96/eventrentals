{
  "version": 2,
  "cleanUrls": true,
  "alias": ["eventrentals.be", "www.eventrentals.be"],
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "*.jpg", "use": "@vercel/static" },
    { "src": "*.jpeg", "use": "@vercel/static" },
    { "src": "*.webp", "use": "@vercel/static" },
    { "src": "*.jfif", "use": "@vercel/static" },
    { "src": "*.avif", "use": "@vercel/static" },
    { "src": "*.xml", "use": "@vercel/static" },
    { "src": "*.txt", "use": "@vercel/static" },
    { "src": "search-data.js", "use": "@vercel/static" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "eventrentals.be" }],
      "destination": "https://www.eventrentals.be/$1",
      "permanent": true
    },
    { "source": "/springkasteel-huren-gent", "destination": "/feestmateriaal-huren-gent", "permanent": true },
    { "source": "/springkasteel-huren-de-pinte", "destination": "/feestmateriaal-huren-de-pinte", "permanent": true },
    { "source": "/springkasteel-huren-nazareth", "destination": "/feestmateriaal-huren-nazareth", "permanent": true },
    { "source": "/springkasteel-huren-merelbeke", "destination": "/feestmateriaal-huren-merelbeke", "permanent": true },
    { "source": "/springkasteel-huren-sint-martens-latem", "destination": "/feestmateriaal-huren-sint-martens-latem", "permanent": true },
    { "source": "/springkasteel-huren-gavere", "destination": "/feestmateriaal-huren-gavere", "permanent": true },
    { "source": "/springkasteel-huren-deinze", "destination": "/feestmateriaal-huren-deinze", "permanent": true },
    { "source": "/springkasteel-huren-oudenaarde", "destination": "/feestmateriaal-huren-oudenaarde", "permanent": true },
    { "source": "/springkasteel-huren-zulte", "destination": "/feestmateriaal-huren-zulte", "permanent": true }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/sitemap.xml", "dest": "/server.js" },
    { "src": "/robots.txt", "dest": "/server.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
